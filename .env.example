# === Gomly — biến môi trường mẫu ===
# Copy thành .env ở thư mục gốc app/ (và apps/api/.env khi chạy API độc lập)

# PostgreSQL (khớp docker-compose.yml)
DATABASE_URL="postgresql://gomly:gomly_dev_password@localhost:5432/gomly?schema=public"

# Redis (hàng đợi intake — BullMQ)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000

# JWT — access token ký bằng secret này (15 phút, chỉ chứa user_id).
# BẮT BUỘC đổi giá trị khác khi deploy thật.
JWT_SECRET="gomly-dev-secret-change-me"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
