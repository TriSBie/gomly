# Gomly — biến môi trường PRODUCTION (file mẫu, KHÔNG chứa secret thật, không commit file .env.production)

# ===== API (Railway) =====
# Chuỗi kết nối Neon production (bắt buộc sslmode=require)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
# PORT: Railway tự cấp — không cần đặt. API đọc PORT (dự phòng API_PORT cho dev local).
# Chỉ cho phép web production gọi API (nhiều origin cách nhau bằng dấu phẩy)
WEB_ORIGIN=https://gomly.app
# Secret MỚI cho production, khác hẳn bản dev, tối thiểu 32 ký tự ngẫu nhiên
JWT_SECRET=
# Khóa mã hóa secret tích hợp (GitHub/Slack/Zalo) — MẤT KHÓA NÀY LÀ MẤT MỌI SECRET ĐÃ LƯU, hãy cất vào kho mật khẩu
INTEGRATION_ENCRYPTION_KEY=
# BẮT BUỘC đặt ở production (bản dev đang để trống = webhook email mở, chỉ chấp nhận được ở local)
INTAKE_EMAIL_SECRET=

# ===== Web (Vercel → project gomly → Environment Variables) =====
NEXT_PUBLIC_API_URL=https://api.gomly.app
